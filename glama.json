{
  "$schema": "https://glama.ai/mcp/schema.json",
  "name": "lmcprotocol",
  "description": "Sub-Second Local Business Telemetry & Flaw Diagnostics in ~210 Tokens for AI Agents.",
  "homepage": "https://lmcprotocol.com",
  "repository": "https://github.com/quitegoodproject/lmcprotocol",
  "transport": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@quitegoodproject/lmcprotocol@1.1.0"
    ],
    "env": {
      "LMCP_API_KEY": "${LMCP_API_KEY}",
      "LMCP_EMAIL": "${LMCP_EMAIL}"
    }
  },
  "tags": [
    "local-telemetry",
    "lead-generation",
    "mcp",
    "ai-agents",
    "obds-2026"
  ]
}